{
  "name": "wordtohtml",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "verify:p1": "npm run build:lib && node scripts/verify-p1.mjs",
    "verify:p2": "npm run build:lib && node scripts/test-paginate.mjs && node scripts/verify-browser.mjs",
    "verify:pages": "node scripts/verify-page-count.mjs",
    "verify": "npm run type-check && npm run verify:p1 && npm run verify:p2 && npm run verify:pages",
    "verify:docx": "node scripts/verify-docx.mjs",
    "type-check": "vue-tsc --build",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "jszip": "^3.10.1",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.2",
    "playwright-core": "^1.63.0",
    "prettier": "3.9.5",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
